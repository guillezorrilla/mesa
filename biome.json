{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/coverage",
      "!**/release",
      "!**/target",
      "!.agents",
      "!.claude",
      "!docs",
      "!pnpm-lock.yaml",
      "!apps/mobile/src/uniwind-types.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["site/**"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "lucide-react-native": {
                    "allowImportNames": ["LucideIcon", "LucideProps"],
                    "message": "Import each icon by path, lucide-react-native/icons/<name>: the package root bundles every icon (ADR-0027)."
                  },
                  "react": {
                    "importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
                    "message": "The React Compiler memoizes and ref is a prop (ADR-0027)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/global.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateCustomProperties": "off"
          }
        }
      }
    }
  ]
}
