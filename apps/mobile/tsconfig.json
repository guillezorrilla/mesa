{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // app.config.ts imports its local plugin as .ts, which Node loads as written.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/*.test.ts"]
}
