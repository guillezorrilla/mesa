{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesa",
  "version": "0.1.0",
  "identifier": "com.guillezorrilla.mesa",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mesa",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1300,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["mesa"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
