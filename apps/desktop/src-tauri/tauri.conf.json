{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesa",
  "version": "../package.json",
  "identifier": "com.guillezorrilla.mesa",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mesa",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1300,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["mesa"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMEM3OUVFNkE4MEEwNTMKUldSVG9JQnE3bmtNckp5a3daa05YaUZMVENkcjlzenl6T1h0WjFRRGgzNm9WMGNGSU5KL20wRTAK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.5"
    }
  }
}
